{
  "name": "P3 Gestão de Usinas",
  "short_name": "P3 Usinas",
  "description": "Gestão das usinas solares da P3 Energy",
  "lang": "pt-BR",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef1ea",
  "theme_color": "#53663a",
  "icons": [
    {
      "src": "icones/p3-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icones/p3-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icones/p3-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png"
          ]
        }
      ]
    }
  }
}
